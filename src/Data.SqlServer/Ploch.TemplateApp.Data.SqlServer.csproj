<Project Sdk="Microsoft.NET.Sdk">

    <!-- Holds the SqlServer migrations and the design-time factory used by the dotnet-ef tool. -->

    <ItemGroup>
        <PackageReference Include="Ploch.Data.EFCore.SqlServer" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Data\Ploch.TemplateApp.Data.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Design-time only: never published with an application that references this project. -->
        <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    </ItemGroup>

</Project>
